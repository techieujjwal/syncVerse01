# SyncVerse environment variables.
# Copy to .env and fill in real values. NEVER commit the real .env.

# ── Supabase (frontend) ──────────────────────────────────────────────────────
# Project URL and publishable (anon) key — both safe for the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ── Gemini AI (optional, client-side fallback only) ─────────────────────────
# Preferred: set GEMINI_API_KEY as a Supabase Edge Function secret and leave this
# blank — the AI explainer then calls the `gemini-explainer` edge function and the
# key never reaches the browser.
# Only set VITE_GEMINI_API_KEY for local development; it ships to every visitor.
# VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=models/gemini-2.5-flash

# ── Internships webhook (optional) ───────────────────────────────────────────
# Base URL of the n8n (or equivalent) webhook service used by /internships.
# Defaults to http://localhost:5678 when unset.
# VITE_INTERNSHIPS_WEBHOOK_URL=
